# No API key needed - this project uses a local Ollama instance.
# Install Ollama from https://ollama.com/download, then run:
#   ollama pull llama3.1:8b
#   ollama pull nomic-embed-text

CHROMA_DIR=chroma_db
COLLECTION_NAME=meridian_supply_chain

# Override if you pulled different Ollama models (e.g. a lighter one for slower hardware)
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text